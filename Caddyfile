# Caddyfile untuk Kasirku POS (Satu Origin: PWA + API)
:80 {
    # Logging akses terstruktur
    log {
        output stdout
        format json
    }

    # Kompresi Gzip dan Zstandard otomatis
    encode gzip zstd

    # Rute API, Dokumentasi OpenAPI, dan Health Check diarahkan ke FastAPI Backend
    handle /api/* {
        reverse_proxy api:8000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /docs* {
        reverse_proxy api:8000
    }

    handle /openapi.json {
        reverse_proxy api:8000
    }

    handle /health {
        reverse_proxy api:8000
    }

    handle /ready {
        reverse_proxy api:8000
    }

    # Berkas Statis PWA Frontend dengan fallback SPA (try_files index.html)
    handle {
        root * /srv/dist
        try_files {path} /index.html
        file_server

        # Caching header untuk service worker dan aset statis
        @serviceWorker {
            path /sw.js /manifest.json
        }
        header @serviceWorker Cache-Control "no-cache, no-store, must-revalidate"

        @asetStatis {
            path /assets/*
        }
        header @asetStatis Cache-Control "public, max-age=31536000, immutable"
    }
}
